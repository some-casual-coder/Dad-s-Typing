{
  "name": "dads-typing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --env-file=.env.local node_modules/vitest/vitest.mjs run",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "check:providers": "node --env-file=.env.local scripts/provider-check.mjs",
    "live:stt": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --config vitest.live.config.ts stt",
    "live:providers": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --config vitest.live.config.ts providers",
    "live:clip": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --config vitest.live.config.ts clip",
    "live:kiswahili": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --config vitest.live.config.ts kiswahili",
    "live:extract": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --config vitest.live.config.ts extract",
    "live:merchant": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --config vitest.live.config.ts discover-merchant",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
