# Copy to .env.local and fill in. Never commit real values.
# Required to run: DATABASE_URL, APP_BASE_URL, PayPal sandbox, one AI provider.
# Everything else is optional and switches a feature on.

# ---- App ----
APP_BASE_URL=http://localhost:3000          # PayPal returns here; links in chats point here
DATABASE_URL=postgres://dt:dt@127.0.0.1:5433/dads_typing
# Only behind a proxy you trust (Render, a load balancer): read the client IP for rate limits
TRUST_PROXY=
TRUST_PROXY_HOPS=1
# Demo spend ceilings per day, per process
AI_DAILY_MAX=3000
STT_DAILY_MAX=500

# ---- PayPal (sandbox only; the server refuses anything else) ----
# developer.paypal.com > Apps & Credentials > Sandbox > your app
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The sandbox Business account's merchant id (Sandbox Accounts > the business account)
PAYPAL_MERCHANT_ID=
# Optional: webhooks need a public HTTPS URL; without it the app polls PayPal
PAYPAL_WEBHOOK_ID=

# ---- AI: pick one provider ----
# OpenRouter (default here): openrouter.ai > Keys. Also used for voice transcription and clip checks.
INTERPRETER_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
STT_MODEL=openai/whisper-large-v3-turbo
# Or Google Gemini directly (aistudio.google.com > API keys): set INTERPRETER_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---- Product search (optional; without it only the labelled demo seller appears) ----
# trychannel3.com > dashboard > API keys. US and GB shops only.
CHANNEL3_API_KEY=

# ---- WhatsApp (optional; see README "WhatsApp") ----
# Shared with connectors/whatsapp, 32+ characters: openssl rand -hex 32
WHATSAPP_BRIDGE_SECRET=
# The bot's number, digits only (e.g. 2547XXXXXXXX). Shows "JOIN" links on order pages.
WHATSAPP_BOT_NUMBER=
# Numbers that may always chat, comma-separated digits; empty means only people let in below
WHATSAPP_ALLOWED_SENDERS=
# 1 = anyone who sends "Hi My Plug!" is let in and gets the intro (the public demo)
CHANNEL_OPEN_START=

# ---- Other channels (optional) ----
# Any channel in src/channel/registry.ts, e.g. sms:
# CHANNEL_SMS_SECRET=
# CHANNEL_SMS_ALLOWED=

# ---- Operator tools (optional) ----
# Signs scripts/operator-refund.mjs and the operator console, 32+ characters
OPERATOR_SECRET=
# Required as well in production (NODE_ENV=production)
OPERATOR_ENABLED=

# ---- Pickup points for order updates (optional; only confirmed values) ----
# HUB_KENTEX_ADDRESS=
# HUB_KENTEX_PIN=            # lat,lon
# HUB_KENTEX_HOURS=
# HUB_KENTEX_PHONE=          # +254...
# HUB_AQUANTUO_ADDRESS=
# HUB_AQUANTUO_PIN=
# HUB_AQUANTUO_HOURS=
# HUB_AQUANTUO_PHONE=

# ---- Shared-link video analysis (optional; off unless all are set) ----
# SUPADATA_ENABLED=1
# SUPADATA_API_KEY=
# SUPADATA_PLATFORMS=instagram,tiktok,facebook
# SUPADATA_URL_ALLOWLIST=    # exact approved posts, e.g. tiktok:7301...
# SUPADATA_ALLOW_ANY_POST=1  # or any public post on the platforms above (an accepted rights risk)
# SUPADATA_CREDIT_CEILING=
# SOURCE_RESOLVE_SHORT_LINKS=1

# ---- Switches ----
# DEMO_CATALOGUE=1           # add the synthetic "Whisker & Co (demo)" cat carriers to every request (tests and old demos only)
# CLIP_ANALYSIS=0            # turn off checks of the shopper's own clips (needs ffmpeg when on)
# FX_PROVIDER=offline        # skip the live exchange rate and use the stored fallback
# PAYPAL_BASE_URL=           # override the sandbox API host (tests only)
