# Copy to .env.local and fill in. Never commit real values.
DEMO_MODE=true
APP_BASE_URL=http://localhost:3000

PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

GEMINI_API_KEY=
