# Copy to .env.local and fill in. Never commit real values.
DEMO_MODE=true
APP_BASE_URL=http://localhost:3000

PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: INTERPRETER_PROVIDER=openrouter uses these instead of Gemini
INTERPRETER_PROVIDER=gemini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Voice transcription model (uses OPENROUTER_API_KEY)
STT_MODEL=openai/whisper-large-v3-turbo

CHANNEL3_API_KEY=

DATABASE_URL=postgres://localhost:5432/dads_typing
SESSION_SECRET=
TRUST_PROXY=
TRUST_PROXY_HOPS=1
# demo spend ceilings per day (per process)
STT_DAILY_MAX=500
AI_DAILY_MAX=3000

PAYPAL_MERCHANT_ID=

# WhatsApp connector bridge (>= 32 chars, shared with connectors/whatsapp)
WHATSAPP_BRIDGE_SECRET=
# Comma-separated sender numbers (digits, no +); empty means everyone is ignored
WHATSAPP_ALLOWED_SENDERS=
# Operator refund route (>= 32 chars); route is disabled when unset
OPERATOR_SECRET=
# the operator route also needs this in production
OPERATOR_ENABLED=

# Optional: pickup points for order updates (only confirmed values)
# HUB_KENTEX_PIN=            # lat,lon
# HUB_KENTEX_HOURS=
# HUB_KENTEX_PHONE=          # +254...
# HUB_AQUANTUO_ADDRESS=
# HUB_AQUANTUO_HOURS=
# HUB_AQUANTUO_PHONE=
# HUB_AQUANTUO_PIN=
# WHATSAPP_BOT_NUMBER=       # shows a wa.me JOIN link when set

# Optional: shared-link video analysis, off unless all are set and approved
# SUPADATA_ENABLED=1
# SUPADATA_API_KEY=
# SUPADATA_PLATFORMS=instagram,tiktok,facebook
# SUPADATA_URL_ALLOWLIST=    # exact approved posts, e.g. tiktok:7301...
# SUPADATA_CREDIT_CEILING=
# SOURCE_RESOLVE_SHORT_LINKS=1
# CLIP_ANALYSIS=0            # turn off the shopper's own clip checks
